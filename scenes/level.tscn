[sub_resource type="GDScript" id="GDScript_7olc6"]
resource_name = "player"
script/source = "extends CharacterBody2D

@export var speed: int = 100
@export var jumpPower: int = 500
@export var friction: float = 0.8
@export var air_res: float = 0.99
@export var bounce: float = 0.4

var gravity: int = ProjectSettings.get_setting(\"physics/2d/default_gravity\")
var last_vy: int
var cartoon_buildup: int = 0
var boingboing: bool = true

func _ready():
	$hurtbox.body_entered.connect(on_hit)

func respawn() -> void:
	position = Vector2.ZERO
	velocity = Vector2.ZERO

func parentPlatform(platform: Node):
	reparent(platform)
	boingboing = false

func resetParent():
	reparent($Node2D)
	boingboing = true
	
func on_hit(body: Node):
	if body.name != \"slime\": return
	respawn()

func _process(_float):
	bounce = 0.2 if Input.is_action_pressed(\"down\") else 0.4
	speed = 200 if Input.is_action_pressed(\"run\") else 100

func _physics_process(delta: float):
	var direction := int(Input.is_action_pressed(\"right\")) - int(Input.is_action_pressed(\"left\"))
	if !is_on_floor():
		velocity.y += gravity * delta
		velocity.x *= air_res
		if direction:
			velocity.x += direction * (speed / 10)
	else:
		if boingboing: velocity.y = floor(last_vy * -bounce)
		if Input.is_action_pressed(\"jump\"):
			velocity.y -= jumpPower
		
		if direction:
			velocity.x += direction * speed
		
		velocity.x *= friction
	
	velocity.x = roundi(velocity.x)
	velocity.y = roundi(velocity.y)
	last_vy = velocity.y
	move_and_slide()
	
	if position.y > 1500:
		respawn()
"

