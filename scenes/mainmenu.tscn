[sub_resource type="Shader" id="Shader_uui5l"]
code = "shader_type canvas_item;

uniform float aspect_ratio = 2;
uniform float rotation_speed = 0.05;
uniform bool as_shadow = false;
 
void fragment() {
	float px = 2.0 * (UV.x - 0.5);
	float py = 2.0 * (UV.y - 0.5);
	
	if (px * px + py * py > 1.0) {
		// Outside of \"sphere\"
		COLOR.a = 0.0;
	} else {
		px = asin(px / sqrt(1.0 - py * py)) * 2.0 / PI;
		py = asin(py) * 2.0 / PI;
		
		COLOR = texture(TEXTURE, vec2(
			0.5 * (px + 1.0) / aspect_ratio - TIME * rotation_speed,
			0.5 * (py + 1.0)));
		if (as_shadow) {
			COLOR.rgb = vec3(0.0, 0.0, 0.0);
			COLOR.a *= 0.9;
		}
	}
}"

